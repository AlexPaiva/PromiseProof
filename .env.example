# Used only by the explicit live investigation commands. Ordinary build and
# test commands never require a key. Copy this file to ignored `.env.local`
# or set the variable in the current shell. Never commit a real value.
# The live provider pins https://api.openai.com/v1; OPENAI_BASE_URL overrides
# are deliberately ignored so a compatible local endpoint cannot fake provenance.
OPENAI_API_KEY=
